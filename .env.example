# Copy to .env and fill in. Never commit .env.
PORT=3001
# Public origin of the site (no trailing slash). Used for canonical URLs, OG tags, sitemap.
SITE_URL=https://example.com
# Set to 1 when running behind one reverse proxy / load balancer (correct client IPs for rate limits)
TRUST_PROXY=
# Path to the SQLite database file
DATABASE_PATH=./data/fiber.db
# Long random string used to sign admin session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string
# Admin login: set ADMIN_PASSWORD (12+ chars), or a pre-hashed ADMIN_PASSWORD_HASH
# from: npm run admin:hash -- "your-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Timezone used for appointment scheduling
APP_TIMEZONE=America/Detroit

# Email (Resend). Without RESEND_API_KEY, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Tucker <hello@mail.trytucker.com>
# Fallback team inbox(es), comma-separated, for locations without their own alert emails
TEAM_NOTIFY_EMAIL=

# Environment & feature flags (all default off — production behaviour unchanged)
# APP_ENV: development | staging | production (defaults from NODE_ENV)
APP_ENV=
# Parent household-savings platform at /savings (staging/dev only for now)
PLATFORM_ENABLED=false
# Illustrative, clearly-labelled sample offers. Refused when APP_ENV=production.
SAMPLE_DATA_ENABLED=false

# Outside production, customer emails go ONLY to these addresses or @domains
# (comma-separated); all others are skipped. Subjects are prefixed [STAGING].
STAGING_EMAIL_ALLOWLIST=

# Domain migration. SITE_URL is the canonical origin (production: https://trytucker.com).
# Older domains that still point at this app are listed in LEGACY_HOSTS; they keep
# working until LEGACY_REDIRECTS=true, then pages redirect permanently to SITE_URL.
LEGACY_HOSTS=
LEGACY_REDIRECTS=false
