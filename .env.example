# Copy to .env and fill in. Never commit .env.
PORT=3001
# Public origin of the site (no trailing slash). Used for canonical URLs, OG tags, sitemap.
SITE_URL=https://example.com
# Set to 1 when running behind one reverse proxy / load balancer (correct client IPs for rate limits)
TRUST_PROXY=
# Path to the SQLite database file
DATABASE_PATH=./data/fiber.db
# Long random string used to sign admin session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string
# Admin login: set ADMIN_PASSWORD (12+ chars), or a pre-hashed ADMIN_PASSWORD_HASH
# from: npm run admin:hash -- "your-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Timezone used for appointment scheduling
APP_TIMEZONE=America/Detroit

# Email (Resend). Without RESEND_API_KEY, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Fiber Connect <hello@mail.livefiberconnect.com>
# Fallback team inbox(es), comma-separated, for locations without their own alert emails
TEAM_NOTIFY_EMAIL=
